# Google AI Studio key for Gemini (free tier is enough for the demo).
# Copy this file to .env.local and fill it in. Never commit .env.local.
GOOGLE_GENERATIVE_AI_API_KEY=

# Rate limiting. The Vercel Marketplace Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead;
# either pair works. Without them, limits fall back to per-instance memory (fine for local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Guard limits (defaults in lib/guard/rate-limit.ts: 15 / 10 min and 60 / day per IP).
RATE_LIMIT_PER_10_MIN=
RATE_LIMIT_PER_DAY=
# ~80% of the key's requests-per-day shown in Google AI Studio, counted in model calls (default 200).
GLOBAL_DAILY_REQUEST_CAP=
# Model calls per minute across all users; Gemini free tier allows 15 RPM for gemini-3.5-flash-lite (default 12).
GLOBAL_PER_MINUTE_CAP=

# Required in production: salt for hashing client IPs in logs and rate-limit keys.
# Without it, hashed IPs are reversible and an error is logged.
IP_HASH_SALT=

# Local UI work without spending Gemini quota: replay a scripted bathroom quote through the real tools.
# Ignored on Vercel production.
CORONA_SCRIPTED_MODEL=
