# =========================================================
#  Plantilla de variables de entorno — Agente Corona
#  Copia este archivo a `.env` y rellena los valores reales.
#  NUNCA commitees el archivo `.env` (está en .gitignore).
# =========================================================

# --- LLM: Anthropic (Claude) — orquestador ---
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Embeddings de las fichas (Chroma se construyó con VoyageAI) ---
# Requerida para la búsqueda SEMÁNTICA en las fichas técnicas.
# Si se deja vacía, el agente usa un fallback por palabra clave (no rompe).
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Base de conocimiento (ya construida por el equipo de datos) ---
# Se espera encontrar estos artefactos en data/processed/:
DUCKDB_PATH=data/processed/corona.duckdb
CHROMA_PATH=data/processed/chroma
CHROMA_COLLECTION=corona_fichas

# --- Parámetros de negocio ---
DESPERDICIO_DEFECTO=0.10

# --- (Opcional) Ingesta desde JSON crudo, si algún día se regenera la base ---
DATA_RAW_DIR=data/raw
DATA_FICHAS_DIR=data/fichas
